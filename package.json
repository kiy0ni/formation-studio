{
  "name": "formation-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Formation Studio - createur de formations de danse K-pop synchronisees avec la musique",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "lan": "HOST=0.0.0.0 node server/index.js",
    "typecheck": "tsc --noEmit",
    "deploy": "sh scripts/deploy-pages.sh",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:android": "node scripts/build-android.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@mediabunny/aac-encoder": "^1.56.2",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "mediabunny": "^1.56.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
